  "events": [ {
    "tStartMs": 15481,
    "dDurationMs": 3971,
    "segs": [ {
      "utf8": " [♪♪♪]"
    } ],
    "wpWinPosId": 1,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 26258,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": " We were once mankind."
    } ],
    "wpWinPosId": 2,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 30763,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": " We were humanity."
    } ],
    "wpWinPosId": 3,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 39071,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": " And now..."
    } ],
    "wpWinPosId": 4,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 41807,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": " We're no more than pests."
    } ],
    "wpWinPosId": 5,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 45544,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": " Vermin."
    } ],
    "wpWinPosId": 6,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 47847,
    "dDurationMs": 2203,
    "segs": [ {
      "utf8": " They came here\n to exterminate us."
    } ],
    "wpWinPosId": 7,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 54888,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": " They took our history\n and culture."
    } ],
    "wpWinPosId": 8,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 57357,
    "dDurationMs": 4204,
    "segs": [ {
      "utf8": " They covered our landworks\n in dying humanity."
    } ],
    "wpWinPosId": 9,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 61561,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": " The wail of the dying\n carried for miles."
    } ],
    "wpWinPosId": 8,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 66733,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": " They're building\n some kind of breeding facility"
    } ],
    "wpWinPosId": 10,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 68701,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": " for those that survive."
    } ],
    "wpWinPosId": 11,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 71404,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": " People that have defected\n say it's worse than Hell,"
    } ],
    "wpWinPosId": 12,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 74607,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": " humans becoming some kind\n of surrogate incubators"
    } ],
    "wpWinPosId": 12,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 77310,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": " for the alien young."
    } ],
    "wpWinPosId": 13,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 85452,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": " They killed us in waves\n when they first arrived."
    } ],
    "wpWinPosId": 14,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 90823,
    "dDurationMs": 4204,
    "segs": [ {
      "utf8": "They built these megastructures\n that spew methane,"
    } ],
    "wpWinPosId": 10,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 95027,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "manufacturing their atmosphere."
    } ],
    "wpWinPosId": 15,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 101000,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": " They've sown their crops,"
    } ],
    "wpWinPosId": 5,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 102301,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": " snuffing out\n our plant life,"
    } ],
    "wpWinPosId": 16,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 103936,
    "dDurationMs": 2537,
    "segs": [ {
      "utf8": "raising the global temperature,\n causing our cities to flood."
    } ],
    "wpWinPosId": 10,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 109808,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": " They waged war on Earth."
    } ],
    "wpWinPosId": 17,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 111878,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": " They set fire to our forests."
    } ],
    "wpWinPosId": 18,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 115047,
    "dDurationMs": 2570,
    "segs": [ {
      "utf8": "It's already hard to breathe..."
    } ],
    "wpWinPosId": 15,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 117617,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": " impossible to breathe\nif you are close to the stacks."
    } ],
    "wpWinPosId": 10,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 123422,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": " Rats..."
    } ],
    "wpWinPosId": 6,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 125524,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": " insects..."
    } ],
    "wpWinPosId": 4,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 127760,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": " humans..."
    } ],
    "wpWinPosId": 19,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 131297,
    "dDurationMs": 1935,
    "segs": [ {
      "utf8": " they hack into our psyche,"
    } ],
    "wpWinPosId": 20,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 133232,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": " into our minds,"
    } ],
    "wpWinPosId": 21,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 134667,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": " paralyzing us,"
    } ],
    "wpWinPosId": 22,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 136535,
    "dDurationMs": 4772,
    "segs": [ {
      "utf8": " taking control of the cerebrum\n and the limbic system,"
    } ],
    "wpWinPosId": 10,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 141307,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": " rendering us slaves."
    } ],
    "wpWinPosId": 13,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 144377,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": " We've been able\n to design a brain barrier"
    } ],
    "wpWinPosId": 12,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 147213,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": " that protects us\n from their influence."
    } ],
    "wpWinPosId": 8,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 150416,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": " They know we can't produce\n enough of these for everyone,"
    } ],
    "wpWinPosId": 23,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 154220,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "that it's just a matter of time"
    } ],
    "wpWinPosId": 15,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 155722,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": " before the entire planet\n is theirs..."
    } ],
    "wpWinPosId": 14,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 159925,
    "dDurationMs": 1569,
    "segs": [ {
