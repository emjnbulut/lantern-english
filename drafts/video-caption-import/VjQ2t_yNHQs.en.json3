    "wpWinPosId": 31,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 217083,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": " We are sold a different story\n by our politicians."
