    "wpWinPosId": 30,
    "wsWinStyleId": 1,
    "pPenId": 1
  }, {
    "tStartMs": 206706,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": " Every vile,\n deceptive, chemical emotion"
