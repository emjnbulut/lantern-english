{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 32240,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "For thousands of years"
    } ]
  }, {
    "tStartMs": 34458,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "Shamans have crossed over\nto the hereafter, the Netherworld,"
    } ]
  }, {
    "tStartMs": 38840,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to find and heal the souls of people."
    } ]
  }, {
    "tStartMs": 42480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "But at the dawn of the 23rd century"
    } ]
  }, {
    "tStartMs": 45320,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "they turn from healers\ninto mankind's most deadly weapon."
    } ]
  }, {
    "tStartMs": 91080,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "Don't worry. Everything will be fine."
    } ]
  }, {
    "tStartMs": 93440,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "The Shaman is here now."
    } ]
  }, {
    "tStartMs": 96080,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "When I'm dead,"
    } ]
  }, {
    "tStartMs": 98480,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "will I be going to the Netherworld?"
    } ]
  }, {
    "tStartMs": 101760,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 103640,
    "dDurationMs": 3026,
    "segs": [ {
      "utf8": "- We are all going there.\n- Have you been there?"
    } ]
  }, {
    "tStartMs": 107800,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 110040,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Not me."
    } ]
  }, {
    "tStartMs": 111250,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "But my master has been\nthere many times."
    } ]
  }, {
    "tStartMs": 115329,
    "dDurationMs": 2871,
    "segs": [ {
      "utf8": "The Shamans go there\nto kill the machines, don't they?"
    } ]
  }, {
    "tStartMs": 118880,
    "dDurationMs": 1536,
    "segs": [ {
      "utf8": "Not the machine, but its soul."
    } ]
  }, {
    "tStartMs": 121880,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Do all machines have a soul?"
    } ]
  }, {
    "tStartMs": 124291,
    "dDurationMs": 979,
    "segs": [ {
      "utf8": "Yes."
    } ]
  }, {
    "tStartMs": 125520,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Every object and every being\nin this world has a soul."
    } ]
  }, {
    "tStartMs": 128440,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "The good ones we can convert.\nThe bad ones we destroy."
    } ]
  }, {
    "tStartMs": 134400,
    "dDurationMs": 1725,
    "segs": [ {
      "utf8": "Does the Shaman cry sometimes?"
    } ]
  }, {
    "tStartMs": 137680,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 139400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The Shaman never cries."
    } ]
  }, {
    "tStartMs": 142000,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "If he ever did, he wouldn't\nbe a Shaman anymore."
    } ]
  }, {
    "tStartMs": 144120,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "Get out of the way!"
    } ]
  }, {
    "tStartMs": 188440,
    "dDurationMs": 2935,
    "segs": [ {
      "utf8": "The enemy battle colossus has taken\nposition on the other side of the plain."
    } ]
  }, {
    "tStartMs": 192880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "We've thrown everything\nwe have against it."
    } ]
  }, {
    "tStartMs": 196320,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "We've lost nearly 2,000 men so far."
    } ]
  }, {
    "tStartMs": 198840,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "That's all the information\nwe could gather about it."
    } ]
  }, {
    "tStartMs": 202240,
    "dDurationMs": 2110,
    "segs": [ {
      "utf8": "We're gonna need\na mobile shieldfire unit with us."
    } ]
  }, {
    "tStartMs": 204600,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "My Shaman has to come as\nclose as possible to the target"
    } ]
  }, {
    "tStartMs": 206500,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "before he transits\nto the Netherworld."
    } ]
  }, {
    "tStartMs": 210160,
    "dDurationMs": 3104,
    "segs": [ {
      "utf8": "No shieldfire will hold\nlonger than five to six minutes, max,"
    } ]
  }, {
    "tStartMs": 214208,
    "dDurationMs": 1307,
    "segs": [ {
      "utf8": "against this monster."
    } ]
  }, {
    "tStartMs": 215765,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "That is all I need."
    } ]
  }, {
    "tStartMs": 218600,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "I always wondered what you guys\nsee over there, in the Netherworld."
    } ]
  }, {
    "tStartMs": 221720,
    "dDurationMs": 2050,
    "segs": [ {
      "utf8": "Must be pretty weird I guess..."
    } ]
  }, {
    "tStartMs": 235120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's an A type personality."
    } ]
  }, {
    "tStartMs": 237333,
    "dDurationMs": 1067,
    "segs": [ {
      "utf8": "Narcissistic."
    } ]
  }, {
    "tStartMs": 239000,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "Probably prone to falling\nfor unmerited flattery."
    } ]
  }, {
    "tStartMs": 241440,
    "dDurationMs": 3643,
    "segs": [ {
      "utf8": "And tends to over-intellectualize.\nIt also tries too hard to understand"
    } ]
  }, {
    "tStartMs": 246160,
    "dDurationMs": 2750,
    "segs": [ {
      "utf8": "and believes the manipulator has a\nreason for everything he says or does."
    } ]
  }, {
    "tStartMs": 249160,
    "dDurationMs": 1465,
    "segs": [ {
      "utf8": "That's how you can trick it."
    } ]
  }, {
    "tStartMs": 251560,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "What is wrong with you?"
    } ]
  }, {
    "tStartMs": 254360,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "What?"
    } ]
  }, {
    "tStartMs": 257440,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "You worry about me."
    } ]
  }, {
    "tStartMs": 261280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I worry about your leaked profile."
    } ]
  }, {
    "tStartMs": 264634,
    "dDurationMs": 2324,
    "segs": [ {
      "utf8": "If the machine knows about you,\nit will try to manipulate you."
    } ]
  }, {
    "tStartMs": 272212,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "In all the years I've known you,"
    } ]
  }, {
    "tStartMs": 273880,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "I've never heard you talk\nabout your family, your parents."
    } ]
  }, {
    "tStartMs": 277727,
    "dDurationMs": 1606,
    "segs": [ {
      "utf8": "Is there anything that I should know?"
    } ]
  }, {
    "tStartMs": 282880,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "- Can you hear me, Joshua?\n- I can hear you."
    } ]
  }, {
    "tStartMs": 285291,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "Do not worry."
    } ]
  }, {
    "tStartMs": 288320,
    "dDurationMs": 1450,
    "segs": [ {
      "utf8": "I love you, Mylord."
    } ]
  }, {
    "tStartMs": 290360,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "I would not want to lose you."
    } ]
  }, {
    "tStartMs": 292360,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Not to such a pile of bloody scrap."
    } ]
  }, {
    "tStartMs": 319200,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "I am alone."
    } ]
  }, {
    "tStartMs": 321360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "If there is a god, why is he\nnot showing his face to me?"
    } ]
  }, {
    "tStartMs": 326200,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "I would look at him,"
    } ]
  }, {
    "tStartMs": 327800,
    "dDurationMs": 1241,
    "segs": [ {
      "utf8": "and I would smile."
    } ]
  }, {
    "tStartMs": 332583,
    "dDurationMs": 2607,
    "segs": [ {
      "utf8": "Once I have crossed over,\ndo not fail me."
    } ]
  }, {
    "tStartMs": 335440,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "Yes, Shaman."
    } ]
  }, {
    "tStartMs": 336680,
    "dDurationMs": 2153,
    "segs": [ {
      "utf8": "The Shaman risks his life for you."
    } ]
  }, {
    "tStartMs": 339083,
    "dDurationMs": 1187,
    "segs": [ {
      "utf8": "You risk yours for him!"
    } ]
  }, {
    "tStartMs": 341250,
    "dDurationMs": 3458,
    "segs": [ {
      "utf8": "We use Sakakibara, Econ dan Aquarte.\n2nd suite, chapter 4. Adagio."
    } ]
  }, {
    "tStartMs": 347080,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "It's too short. The piece is\nonly four minutes long."
    } ]
  }, {
    "tStartMs": 349400,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "That is how I will break it.\nTrust me."
    } ]
  }, {
    "tStartMs": 353520,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "I always trust you, My Lord."
    } ]
  }, {
    "tStartMs": 357520,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Let's go."
    } ]
  }, {
    "tStartMs": 464085,
    "dDurationMs": 1248,
    "segs": [ {
      "utf8": "I must cross over now."
    } ]
  }, {
    "tStartMs": 517417,
    "dDurationMs": 1791,
    "segs": [ {
      "utf8": "In all the years I've known you,"
    } ]
  }, {
    "tStartMs": 519458,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "I've never heard you talk\nabout your family, your parents."
    } ]
  }, {
    "tStartMs": 521750,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "Is there anything that I should know?"
    } ]
  }, {
    "tStartMs": 579560,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Who are you?"
    } ]
  }, {
    "tStartMs": 582240,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "You look wonderful."
    } ]
  }, {
    "tStartMs": 584120,
    "dDurationMs": 2005,
    "segs": [ {
      "utf8": "You are far more beautiful\nthan I expected."
    } ]
  }, {
    "tStartMs": 587720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "You remind me of someone."
    } ]
  }, {
    "tStartMs": 590040,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "Who is that?"
    } ]
  }, {
    "tStartMs": 591333,
    "dDurationMs": 857,
    "segs": [ {
      "utf8": "Seduction."
    } ]
  }, {
    "tStartMs": 592440,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "Use charm in order\nto lower the target's defenses."
    } ]
  }, {
    "tStartMs": 596040,
    "dDurationMs": 3627,
    "segs": [ {
      "utf8": "She was my friend. I was in love\nwith her, yet she never loved me."
    } ]
  }, {
    "tStartMs": 602480,
    "dDurationMs": 1395,
    "segs": [ {
      "utf8": "Do you know who I am?"
    } ]
  }, {
    "tStartMs": 605000,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Of course.\nYou are the great battle colossus."
    } ]
  }, {
    "tStartMs": 611080,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "It is a beautiful day today.\nIsn't it?"
    } ]
  }, {
    "tStartMs": 614125,
    "dDurationMs": 4235,
    "segs": [ {
      "utf8": "Diversion. Target tries to steer the\nconversation onto another topic."
    } ]
  }, {
    "tStartMs": 618720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "I wish it could last forever.\nTime is so short."
    } ]
  }, {
    "tStartMs": 622250,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "Isn't it?"
    } ]
  }, {
    "tStartMs": 624148,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "They increased the price for fruits."
    } ]
  }, {
    "tStartMs": 626360,
    "dDurationMs": 1990,
    "segs": [ {
      "utf8": "But you should never\nfreeze strawberries."
    } ]
  }, {
    "tStartMs": 629167,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "- As they don't like it.\n- Evasion."
    } ]
  }, {
    "tStartMs": 631280,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Target gives irrelevant responses\nin order to evade the manipulation."
    } ]
  }, {
    "tStartMs": 639760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I know why you're here."
    } ]
  }, {
    "tStartMs": 642800,
    "dDurationMs": 1783,
    "segs": [ {
      "utf8": "You are not a soul\nlike the rest of us."
    } ]
  }, {
    "tStartMs": 645320,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "You're a Shaman."
    } ]
  }, {
    "tStartMs": 648640,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "But you will not succeed."
    } ]
  }, {
    "tStartMs": 652400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "I have seen men like you."
    } ]
  }, {
    "tStartMs": 655520,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "- I have destroyed them.\n- Good."
    } ]
  }, {
    "tStartMs": 658080,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Then you know why I am here."
    } ]
  }, {
    "tStartMs": 660600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "You came here to cheat me."
    } ]
  }, {
    "tStartMs": 667417,
    "dDurationMs": 1208,
    "segs": [ {
      "utf8": "Hurry up, Joshua!"
    } ]
  }, {
    "tStartMs": 671720,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "Oh..."
    } ]
  }, {
    "tStartMs": 672917,
    "dDurationMs": 884,
    "segs": [ {
      "utf8": "By the way"
    } ]
  }, {
    "tStartMs": 675040,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "I saw your file."
    } ]
  }, {
    "tStartMs": 678120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I know about your parents."
    } ]
  }, {
    "tStartMs": 681320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And the way they died."
    } ]
  }, {
    "tStartMs": 686520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "It was a beautiful day."
    } ]
  }, {
    "tStartMs": 688560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Like today."
    } ]
  }, {
    "tStartMs": 691160,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "Your mother was making dinner.\nYour father was working from home."
    } ]
  }, {
    "tStartMs": 694840,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "That day"
    } ]
  }, {
    "tStartMs": 696440,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "you returned to your hometown."
    } ]
  }, {
    "tStartMs": 699708,
    "dDurationMs": 2122,
    "segs": [ {
      "utf8": "You went to your parents' house,"
    } ]
  }, {
    "tStartMs": 702080,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "you locked all the doors."
    } ]
  }, {
    "tStartMs": 705167,
    "dDurationMs": 1375,
    "segs": [ {
      "utf8": "Then you set the house on fire."
    } ]
  }, {
    "tStartMs": 708292,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "They looked at you through\nthe window while they burned to death."
    } ]
  }, {
    "tStartMs": 713120,
    "dDurationMs": 1910,
    "segs": [ {
      "utf8": "That must have been terrible."
    } ]
  }, {
    "tStartMs": 715280,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 716480,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "- It was an accident!\n- No."
    } ]
  }, {
    "tStartMs": 718031,
    "dDurationMs": 1136,
    "segs": [ {
      "utf8": "It was an accident!"
    } ]
  }, {
    "tStartMs": 719417,
    "dDurationMs": 1024,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 721000,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "That was a choice you made.\nIt was part of your Shaman education"
    } ]
  }, {
    "tStartMs": 724553,
    "dDurationMs": 2397,
    "segs": [ {
      "utf8": "to show your total determination\ntowards your new life."
    } ]
  }, {
    "tStartMs": 727200,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "That was a choice you made."
    } ]
  }, {
    "tStartMs": 729583,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "No, I never chose."
    } ]
  }, {
    "tStartMs": 732040,
    "dDurationMs": 2990,
    "segs": [ {
      "utf8": "Couldn't you just have told\nthem to leave and disappear?"
    } ]
  }, {
    "tStartMs": 735280,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "But you chose to obey the order."
    } ]
  }, {
    "tStartMs": 737280,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "So tell me, Shaman."
    } ]
  }, {
    "tStartMs": 739120,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Why..."
    } ]
  }, {
    "tStartMs": 740840,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Why?!"
    } ]
  }, {
    "tStartMs": 751292,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "Joshua! We are gonna die!"
    } ]
  }, {
    "tStartMs": 768520,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Come on, mate."
    } ]
  }, {
    "tStartMs": 769771,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "Just kill this thing and come back!"
    } ]
  }, {
    "tStartMs": 771640,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "There's still a life\nwaiting for you here!"
    } ]
  }, {
    "tStartMs": 788454,
    "dDurationMs": 3199,
    "segs": [ {
      "utf8": "And tends to over-intellectualize.\nIt also tries too hard to understand"
    } ]
  }, {
    "tStartMs": 791903,
    "dDurationMs": 2514,
    "segs": [ {
      "utf8": "and believes the manipulator has a\nreason for everything he says or does."
    } ]
  }, {
    "tStartMs": 794840,
    "dDurationMs": 1897,
    "segs": [ {
      "utf8": "That's how you can trick it."
    } ]
  }, {
    "tStartMs": 808720,
    "dDurationMs": 1197,
    "segs": [ {
      "utf8": "Oh, you're back."
    } ]
  }, {
    "tStartMs": 810167,
    "dDurationMs": 1473,
    "segs": [ {
      "utf8": "Your favorite dish is ready."
    } ]
  }, {
    "tStartMs": 816128,
    "dDurationMs": 1206,
    "segs": [ {
      "utf8": "What's so funny?"
    } ]
  }, {
    "tStartMs": 820040,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "What is funny?"
    } ]
  }, {
    "tStartMs": 821880,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "You believed\nthe story about my parents."
    } ]
  }, {
    "tStartMs": 824680,
    "dDurationMs": 2279,
    "segs": [ {
      "utf8": "What a simple-minded fool you are."
    } ]
  }, {
    "tStartMs": 828040,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "They are alive."
    } ]
  }, {
    "tStartMs": 829680,
    "dDurationMs": 830,
    "segs": [ {
      "utf8": "No."
    } ]
  }, {
    "tStartMs": 830760,
    "dDurationMs": 1490,
    "segs": [ {
      "utf8": "They are dead. It is in your file."
    } ]
  }, {
    "tStartMs": 832500,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "- You killed them.\n- You said yourself I cannot be trusted."
    } ]
  }, {
    "tStartMs": 836400,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "We faked my file, then passed\nit on to your intelligence."
    } ]
  }, {
    "tStartMs": 839720,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It will only take me one more minute"
    } ]
  }, {
    "tStartMs": 842334,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "to finish this here."
    } ]
  }, {
    "tStartMs": 846360,
    "dDurationMs": 1175,
    "segs": [ {
      "utf8": "You are lying."
    } ]
  }, {
    "tStartMs": 848360,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Listen..."
    } ]
  }, {
    "tStartMs": 850920,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Do you hear the music?"
    } ]
  }, {
    "tStartMs": 854480,
    "dDurationMs": 3224,
    "segs": [ {
      "utf8": "Perhaps you are familiar with it.\nIt's certainly not my favorite."
    } ]
  }, {
    "tStartMs": 857954,
    "dDurationMs": 2129,
    "segs": [ {
      "utf8": "But it is four minutes long,\nwhich is precisely"
    } ]
  }, {
    "tStartMs": 860333,
    "dDurationMs": 1324,
    "segs": [ {
      "utf8": "why I chose it."
    } ]
  }, {
    "tStartMs": 862400,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "So tell me, machine,"
    } ]
  }, {
    "tStartMs": 865125,
    "dDurationMs": 2875,
    "segs": [ {
      "utf8": "why would I choose a piece\nthat is only four minutes long?"
    } ]
  }, {
    "tStartMs": 869320,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Why?"
    } ]
  }, {
    "tStartMs": 871791,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Why?!"
    } ]
  }, {
    "tStartMs": 873333,
    "dDurationMs": 2777,
    "segs": [ {
      "utf8": "Because I knew it would take me\nno longer than four minutes"
    } ]
  }, {
    "tStartMs": 876360,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "to end you."
    } ]
  }, {
    "tStartMs": 880280,
    "dDurationMs": 1512,
    "segs": [ {
      "utf8": "You are dead, fucker."
    } ]
  }, {
    "tStartMs": 890360,
    "dDurationMs": 2724,
    "segs": [ {
      "utf8": "I am your servant.\nI will do as you say."
    } ]
  }, {
    "tStartMs": 893600,
    "dDurationMs": 1859,
    "segs": [ {
      "utf8": "Please...\nPlease don’t kill me."
    } ]
  }, {
    "tStartMs": 895709,
    "dDurationMs": 2398,
    "segs": [ {
      "utf8": "Then turn against your God\nand your commanders,"
    } ]
  }, {
    "tStartMs": 898357,
    "dDurationMs": 2018,
    "segs": [ {
      "utf8": "and support our troops in the battle."
    } ]
  }, {
    "tStartMs": 927520,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "I killed them."
    } ]
  }, {
    "tStartMs": 929120,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I killed them!"
    } ]
  } ]
}
